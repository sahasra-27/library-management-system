# Frontend Environment Variables Template
# Copy this file to .env.local for local development or set VITE_API_URL in Vercel / Netlify / Render settings.

# Backend API Base URL (default for local development)
VITE_API_URL=http://localhost:8081/api

# Example for production deployment on Railway / Render / Heroku:
# VITE_API_URL=https://your-backend-service.up.railway.app/api
