# Backend Environment Variables Template
# Copy this file to .env or set these variables in your hosting provider (Railway, Heroku, etc.)

# Server Port (default: 8081 for local development)
PORT=8081

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_library
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Or full JDBC URL override (optional)
# SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/smart_library?useSSL=true

# Mail Server Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# CORS Allowed Origins (default: *)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-app.vercel.app
